# ============================================================
# PostgreSQL
# ============================================================

POSTGRES_USER=qurelio
POSTGRES_PASSWORD=change-me
POSTGRES_DB=qurelio_db


# ============================================================
# JWT
# ============================================================

JWT_SECRET=change-me-long-random
JWT_REFRESH_SECRET=change-me-other-long-random
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d


# ============================================================
# MinIO (Object Storage)
# ============================================================

MINIO_ACCESS_KEY=qurelio
MINIO_SECRET_KEY=change-me
MINIO_BUCKET=qurelio-docs
MINIO_PUBLIC_URL=http://localhost:9000


# ============================================================
# Email
# Leave blank if OTP emails are not required
# ============================================================

SENDGRID_API_KEY=
SENDGRID_SENDER_EMAIL=no-reply@example.com
SENDGRID_TEMPLATE_ID=


# ============================================================
# Frontend / CORS
# ============================================================

FRONTEND_URL=http://localhost:3001


# ============================================================
# Service-to-Service Token
# ============================================================

DOCUMENT_INTERNAL_TOKEN=qurelio-dev-internal


# ============================================================
# Regulatory source monitoring (document-service)
# ============================================================

# Scheduler tick frequency, source batch size and maximum concurrent requests.
# Source intervals default from the tutor-provided cadence, capped at 7 days; admins can set a faster custom interval.
REGULATORY_MONITOR_TICK_MS=60000
REGULATORY_MONITOR_BATCH_SIZE=10
REGULATORY_MONITOR_CONCURRENCY=4
# Notification service URL/token are wired through docker-compose in this project.
# Notification events request human impact review; they do not imply confirmed legal changes.


# ============================================================
# AI / RAG — Groq (primary) + OpenRouter (fallback / embeddings)
# ============================================================

OPENAI_API_KEY=YOUR_API
OPENAI_BASE_URL=
OPENAI_MODEL=
STRUCTURE_MODEL=

# Standards/regulations extraction: all candidate passages are reviewed by AI.
# Long documents and small provider quotas can require a longer overall budget.
STANDARD_LLM_ENABLED=true
STANDARD_REQUIREMENT_BATCH_CHARS=2200
STANDARD_REQUIREMENT_BATCH_SECTIONS=2
STANDARD_REQUIREMENT_MAX_OUTPUT_TOKENS=900
STANDARD_EXTRACTION_TIMEOUT_SEC=1800
STANDARD_OCR_LANGUAGES=eng+fra+ara
STANDARD_OCR_MAX_PAGES=30
STANDARD_OCR_TOTAL_TIMEOUT_SEC=300
LLM_REQUEST_TIMEOUT_SEC=180

# ------------------------------------------------------------------
# Extraction reliability (rate-limit / retry / concurrency)
# ------------------------------------------------------------------

# Secondary model used when the primary extraction provider is exhausted (402)
# or fails non-recoverably. Must be multimodal + structured-output capable.
# Empty = inherit CHAT_LLM_FALLBACK_MODEL. (Currently unused by the code.)
STRUCTURE_FALLBACK_MODEL=
# Max retry attempts for a single extraction LLM call (non-rate-limit errors).
EXTRACTION_MAX_ATTEMPTS=5
# Base exponential backoff (s) for non-rate-limit errors.
RETRY_BACKOFF_SEC=2.0
# Base exponential backoff (s) for rate-limit (429) errors — slower on purpose.
RATE_LIMIT_BACKOFF_SEC=8.0
# Ceiling on cumulative backoff (s); also caps provider Retry-After.
MAX_RETRY_BACKOFF_SEC=120.0
# Extra jitter (s) applied on every backoff to desynchronise concurrent retries.
RETRY_JITTER_SEC=1.5
# Max documents running their AI extraction step simultaneously.
MAX_CONCURRENT_EXTRACTIONS=3
# GLOBAL cap on in-flight LLM requests across ALL documents and chunks.
# For free/low-tier OpenRouter set 1/1; raise for paid plans.
EXTRACTION_WORKERS=4

# ------------------------------------------------------------------
# Extraction completeness (chunking / scanned-PDF bounds)
# ------------------------------------------------------------------
# Preferred max chars per logical chunk; never dropped silently.
EXTRACTION_CHUNK_CHARS=9000
EXTRACTION_CHUNK_OVERLAP=550
# Hard safety cap on in-flight chunks (bounds, never discards).
MAX_STRUCTURE_CHUNKS=256
# Max pages fed into a single vision request (beyond = further requests).
MAX_PAGES_PER_VISION_REQUEST=6
# Scanned-page OCR -> vision fallback threshold (chars).
TEXT_FALLBACK_MIN_CHARS=40


# ============================================================
# Embeddings / Vector Search
# ============================================================

EMBEDDING_API_KEY=YOUR_API
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=


# ============================================================
# Pinecone
# ============================================================

PINECONE_API_KEY=your-pinecone-key
PINECONE_INDEX_NAME=qurelio-vectors


# ============================================================
# Chat / LLM Fallback
# ============================================================

CHAT_LLM_FALLBACK_API_KEY=YOUR API
CHAT_LLM_FALLBACK_BASE_URL=https://api.groq.com/openai/v1
CHAT_LLM_FALLBACK_MODEL=openai/gpt-oss-120b


# ============================================================
# RAG
# ============================================================

RAG_INGEST_ENABLED=true


# ============================================================
# Super Admin
# ============================================================

SUPER_ADMIN_EMAIL=admin@qurelio.com
SUPER_ADMIN_PASSWORD=SuperAdmin@2024!

ISO_CHUNK_CONCURRENCY=1
ISO_STRUCTURE_CHUNK_CHARS=3000
